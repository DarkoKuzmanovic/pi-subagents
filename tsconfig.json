{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "noImplicitOverride": true,
    "paths": {
      "@earendil-works/pi-coding-agent": ["./test/support/shims/pi-coding-agent.d.ts"],
      "@earendil-works/pi-ai": ["./test/support/shims/pi-ai.d.ts"],
      "@earendil-works/pi-agent-core": ["./test/support/shims/pi-agent-core.d.ts"],
      "@earendil-works/pi-tui": ["./test/support/shims/pi-tui.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "test"]
}
